FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ENVIRONMENT=production \
    EDURECOVER_CLASSROOM_STATE_DIR=/app/.edurecover_classroom_state \
    EDURECOVER_PERSISTENT_MOUNT_PATH=/app/.edurecover_classroom_state \
    EDURECOVER_PROVIDER_TRANSPORT=bedrock \
    EDURECOVER_REQUIRE_ZDR=false

WORKDIR /app
COPY requirements.txt requirements-aws.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-aws.txt \
    && groupadd --gid 10001 edurecover \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin edurecover
COPY app ./app
COPY training ./training
COPY SERVER_STORAGE_LOCATIONS.txt ./SERVER_STORAGE_LOCATIONS.txt
COPY scripts/aws_migration_snapshot.py ./scripts/aws_migration_snapshot.py
COPY deployment/aws/entrypoint.py ./deployment/aws/entrypoint.py
COPY deployment/aws/restore_from_file.py ./deployment/aws/restore_from_file.py
RUN mkdir -p /app/.edurecover_classroom_state \
    && chown 10001:10001 /app/.edurecover_classroom_state

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1
ENTRYPOINT ["python", "/app/deployment/aws/entrypoint.py"]
