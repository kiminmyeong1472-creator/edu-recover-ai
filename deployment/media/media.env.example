# Copy exact values from your paid ASR provider. No key-length/hex restrictions.
# This file contains examples only. Never commit a real credential.
MEDIA_ASR_ENDPOINT=
MEDIA_ASR_MODEL=
MEDIA_ASR_API_KEY=
# Set true only after checking the provider's actual account/endpoint retention policy.
MEDIA_ASR_DATA_POLICY_ACK=false
MEDIA_ASR_RESPONSE_FORMAT=verbose_json
MEDIA_MAX_UPLOAD_MB=128
MEDIA_MAX_DURATION_SECONDS=7200
MEDIA_CHUNK_SECONDS=120
MEDIA_MAX_OCR_FRAMES=24
MEDIA_OCR_LANGUAGES=kor+eng
MEDIA_PROCESS_TIMEOUT_SECONDS=1800
# Existing Railway persistent volume; results expire in 24h, uploads deleted after processing.
MEDIA_STORAGE_ROOT=/app/.edurecover_classroom_state/media
