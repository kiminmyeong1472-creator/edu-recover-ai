OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-sonnet-5

# Server-only transport for OpenAI and Claude. AWS deployment must set bedrock;
# Gemini always uses its existing enterprise Google Cloud client independently.
EDURECOVER_PROVIDER_TRANSPORT=direct
AWS_REGION=ap-northeast-2
# Explicit inference profiles only. No implicit model or direct API fallback.
# Keep real profiles private; do not publish them in frontend settings.
EDURECOVER_BEDROCK_OPENAI_INFERENCE_PROFILE=
EDURECOVER_BEDROCK_CLAUDE_INFERENCE_PROFILE=
# AWS credentials use the SDK chain/IAM role. Do not put keys in this example.
# Owner temporarily disabled ZDR enforcement. true is a future explicit opt-in.
# Approval flags remain factual records; do not invent provider-side approval.
EDURECOVER_REQUIRE_ZDR=false
EDURECOVER_OPENAI_ZDR_CONFIRMED=false
EDURECOVER_OPENAI_ZDR_BASIS=
EDURECOVER_CLAUDE_ZDR_CONFIRMED=false
EDURECOVER_CLAUDE_ZDR_BASIS=
# Retention queries are optional diagnostics and do not block model calls.
# The application never changes AWS account retention policy automatically.
